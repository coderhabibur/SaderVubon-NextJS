# ==============================================================================
# Sader Vubon - Next.js & TypeScript Git Ignore Configuration
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Outputs
/.next/
/out/
/build
/dist

# Testing & Coverage
/coverage

# Environment Variables & Secrets (CRITICAL FOR GITHUB SECURITY)
# .env
# .env*.local
# .env.development.local
# .env.test.local
# .env.production.local
# .env.local

# Allow committing environment templates
!.env.example
!.env.local.example

# Debugging & Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel & Deployment
.vercel

# SSL Certificates & Keys
*.pem
*.key
*.cert
*.crt

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary & Scratch Files
/scratch/
*.tmp
*.temp
*.bak
