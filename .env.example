# ==========================================================
# Sader Vubon Headless Frontend - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# ==========================================================

# WordPress / WooCommerce Backend URL
NEXT_PUBLIC_WORDPRESS_URL=https://sadervubon.com

# WooCommerce REST API Credentials (Read/Write)
WC_CONSUMER_KEY=ck_your_consumer_key_here
WC_CONSUMER_SECRET=cs_your_consumer_secret_here
